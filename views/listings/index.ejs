<% layout("/layouts/boilerplate") %>
<body>
    
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            margin-top: 1rem;
            align-items: center;
            margin-bottom: 2rem;
        }

        .filter:hover {
            opacity: 1;
        }

        .filter {
            text-align: center;
            margin-right: 1.5rem;
            margin-top: 1rem;
            opacity: 0.6;
        }

        .links {
            text-decoration: none;
            color: #222222;
        }

        .filter p{
            font-size: 0.8rem;
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {
            border: 1px solid rgb(190, 190, 190);
            border-radius: 1rem;
            display: flex;
            padding: 1rem;
            justify-content: center;
            align-items: center;
            height: 3rem;
            margin-left: 3rem;
        }

        .links .filter {
  color: #6a6a6a;
}

.links.active .filter {
    opacity: 1;
  color: #222;
  border-bottom: 2px solid #222;
}

    </style>

    <div id="filters" class="navbar navbar-expand-lg">
    <a href="/listings" class="links <%= activeCategory === null ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
    </div></a>    
    <a href="/listings/category/trending" class="links <%= activeCategory === 'trending' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div></a>
    <a href="/listings/category/rooms" class="links <%= activeCategory === 'rooms' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Room</p>
    </div></a>
    <a href="/listings/category/iconic-cities" class="links <%= activeCategory === 'iconic-cities' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
    </div></a>
    <a href="/listings/category/mountains" class="links <%= activeCategory === 'mountains' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div></a>
    <a href="/listings/category/camping" class="links <%= activeCategory === 'camping' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div></a>
    <a href="/listings/category/beach" class="links <%= activeCategory === 'beach' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </div></a>
    <a href="/listings/category/pools" class="links <%= activeCategory === 'pools' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Pools</p>
    </div></a>
    <a href="/listings/category/artic" class="links <%= activeCategory === 'artic' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Artic</p>
    </div></a>
    <a href="/listings/category/lakefront" class="links <%= activeCategory === 'lakefront' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Lakefront</p>
    </div></a>
    <a href="/listings/category/farms" class="links <%= activeCategory === 'farms' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div></a>
    <a href="/listings/category/castles" class="links <%= activeCategory === 'castles' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div></a>
    <a href="/listings/category/boats" class="links <%= activeCategory === 'boats' ? 'active' : '' %>"><div class="filter">
        <div><i class="fa-solid fa-sailboat"></i></div>
        <p>Boats</p>
    </div></a>
    <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Tax Included</label>
            </div>
        </div>

</div>

        


    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(listing of allListings) { %>
            <a class="card-link" href="/listings/<%= listing._id %>">
            <div class="card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b> <br>
                    PKR <%= listing.price.toLocaleString("en-pk") %>/night 
                    <i class="tax-info"> &nbsp; + 16% GST</i> 
                </p> 
            </div>
            </div></a>
        <% } %>
    </div>

    <% if (allListings.length === 0) { %>
  <div class="text-center my-5">
    <i class="fa-solid fa-map-location-dot" style="font-size: 48px; color: #ccc;"></i>
    <h4 class="mt-3">No listings found</h4>
    <p class="text-secondary">
      There are currently no listings in this category. Try another one or view all listings.
    </p>
    <a href="/listings" class="btn btn-outline-dark rounded-pill mt-2">View all listings</a>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% allListings.forEach(listing => { %>
      <!-- your existing listing card markup -->
    <% }) %>
  </div>
<% } %>

</body>


<script>
    let taxToggle = document.getElementById("switchCheckDefault")
    let taxInfo = document.getElementsByClassName("tax-info")
    for (let info of taxInfo){
        taxToggle.addEventListener("click", () => {
            if(info.style.display !== "inline") {
                info.style.display = "inline"
            } else {
                info.style.display = "none"
            }
        })
    }
</script>