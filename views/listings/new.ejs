<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h2>Create a new Listing</h2> <br>
    <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="title" id="title" placeholder="Add a title" class="form-control" required>
            <div class="invalid-feedback">Please Enter Title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
          <textarea name="description" id="description" class="form-control" required></textarea>
          <div class="invalid-feedback">Please Enter Description</div>  
        </div>
          
        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
            <input type="file" name="image" id="image" class="form-control" required>
            <div class="invalid-feedback">Please Upload Image</div>
        </div>


        <div class="mb-3">
            <label class="form-label d-block">Categories</label>
            <div class="d-flex flex-wrap gap-2">
                <% categories.forEach(cat => { %>
                    <input 
                        type="checkbox" 
                        class="btn-check" 
                        name="category" 
                        value="<%= cat.value %>" 
                        id="cat-<%= cat.value %>" 
                        autocomplete="off"
                    >
                    <label class="btn btn-outline-dark rounded-pill px-3 py-2" for="cat-<%= cat.value %>">
                        <%= cat.label %>
                    </label>
                <% }) %>
                <div class="invalid-feedback">Please select at least one category</div>
            </div>
        </div>




    <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input type="number" name="price" id="price" placeholder="Enter price" class="form-control" required>
            <div class="invalid-feedback">Please Enter Valid Price</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="country" id="country" placeholder="Pakistan" class="form-control" required>
            <div class="invalid-feedback">Please Enter Valid Country name</div>
        </div>
    </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="location" id="location" placeholder="Hunza Valley, KPK" class="form-control" required>
            <div class="invalid-feedback">Please Enter Valid Location</div>
        </div>
        <button class="btn btn-dark add-btn mt-3">Add</button>
        <br><br>
    </form>
        </div>
    </div>

    <script>
(function () {
  "use strict";
  const form = document.querySelector(".needs-validation");
  const categoryBoxes = form.querySelectorAll('input[name="category"]');

  function validateCategories() {
    const anyChecked = Array.from(categoryBoxes).some(cb => cb.checked);
    categoryBoxes[0].setCustomValidity(anyChecked ? "" : "Select at least one category");
  }

  categoryBoxes.forEach(cb => cb.addEventListener("change", validateCategories));

  form.addEventListener("submit", () => {
    validateCategories();
  }, false);
})();
</script>


</body>